# Apply after all project targets have been created. Only GGML is profiled.
function(qwen_limit_pgo_targets)
    if(QWEN_PGO_PHASE STREQUAL "gen")
        set(disable_flag -no-prof-gen)
    elseif(QWEN_PGO_PHASE STREQUAL "use")
        set(disable_flag -no-prof-use)
    else()
        return()
    endif()
    foreach(target llama common llama-common llama-bench-impl llama-bench llama-cli llama-server llama-perplexity test-quantize-fns)
        if(TARGET ${target})
            target_compile_options(${target} PRIVATE ${disable_flag})
            message(STATUS "QWEN PGO: ${target}: ${disable_flag}; GGML retains ${QWEN_PGO_PHASE}")
        endif()
    endforeach()
endfunction()
cmake_language(DEFER CALL qwen_limit_pgo_targets)
