include_guard(GLOBAL)

# Traverse actual targets instead of maintaining an incomplete list of names.
function(qwen_limit_directory_pgo directory)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS targets)
        get_target_property(kind ${target} TYPE)
        if(NOT kind MATCHES "^(EXECUTABLE|STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|OBJECT_LIBRARY)$")
            continue()
        endif()
        get_target_property(source_dir ${target} SOURCE_DIR)
        if(source_dir MATCHES "/ggml(/|$)")
            message(STATUS "QWEN PGO V2: ${target}: GGML retains ${QWEN_PGO_PHASE}")
            continue()
        endif()
        target_compile_options(${target} PRIVATE ${disable_flag})
        if(kind MATCHES "^(EXECUTABLE|SHARED_LIBRARY|MODULE_LIBRARY)$")
            target_link_options(${target} PRIVATE ${disable_flag})
        endif()
        message(STATUS "QWEN PGO V2: ${target}: compile/link ${disable_flag}")
    endforeach()
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        qwen_limit_directory_pgo("${child}")
    endforeach()
endfunction()

function(qwen_limit_all_pgo)
    if(QWEN_PGO_PHASE STREQUAL "gen")
        set(disable_flag -no-prof-gen)
    elseif(QWEN_PGO_PHASE STREQUAL "use")
        set(disable_flag -no-prof-use)
    else()
        return()
    endif()
    qwen_limit_directory_pgo("${CMAKE_SOURCE_DIR}")
endfunction()
cmake_language(DEFER CALL qwen_limit_all_pgo)
