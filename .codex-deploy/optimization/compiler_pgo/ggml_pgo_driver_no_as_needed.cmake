# Keep the thin benchmark entry instrumented for Intel's profile runtime.
function(qwen_limit_pgo_targets)
    if(QWEN_PGO_PHASE STREQUAL "gen")
        set(disable_flag -no-prof-gen)
    elseif(QWEN_PGO_PHASE STREQUAL "use")
        set(disable_flag -no-prof-use)
    else()
        return()
    endif()
    # CMake places global linker flags after target link options. Keep PGO in
    # C/CXX flags (also used by the link driver), remove duplicate global flags
    # so a cold target's final -no-prof-* is effective.
    foreach(variable CMAKE_EXE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS CMAKE_MODULE_LINKER_FLAGS)
        set(clean "${${variable}}")
        string(REGEX REPLACE "-prof-(gen|use)(=[^ ]+)?" "" clean "${clean}")
        string(REGEX REPLACE "-prof-dir +[^ ]+" "" clean "${clean}")
        set(${variable} "${clean}" CACHE STRING "Global linker flags without duplicate PGO options" FORCE)
        set(${variable} "${clean}" PARENT_SCOPE)
    endforeach()
    qwen_visit_pgo_directory("${CMAKE_SOURCE_DIR}" "${disable_flag}")
endfunction()
function(qwen_visit_pgo_directory directory disable_flag)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS targets)
        get_target_property(kind ${target} TYPE)
        if(NOT target MATCHES "^ggml" AND NOT target STREQUAL "llama-bench" AND NOT kind STREQUAL "INTERFACE_LIBRARY" AND NOT kind STREQUAL "UTILITY")
            target_compile_options(${target} PRIVATE ${disable_flag})
            if(kind STREQUAL "SHARED_LIBRARY" OR kind STREQUAL "MODULE_LIBRARY" OR kind STREQUAL "EXECUTABLE")
                target_link_options(${target} PRIVATE ${disable_flag})
                # Intel driver option must remain after any global link flags.
                target_link_libraries(${target} PRIVATE "${disable_flag}")
            endif()
            message(STATUS "QWEN PGO compile+link: ${target}: ${disable_flag}; GGML and thin llama-bench entry retain ${QWEN_PGO_PHASE}")
        endif()
    endforeach()
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        qwen_visit_pgo_directory("${child}" "${disable_flag}")
    endforeach()
endfunction()
cmake_language(DEFER CALL qwen_limit_pgo_targets)
