#!/bin/bash
#BSUB -J qwen38_candidate_build
#BSUB -q ssc-cpu
#BSUB -m hg_6148
#BSUB -n 40
#BSUB -R "span[ptile=40]"
#BSUB -W 02:00
#BSUB -o /work/apac2602/qwen38-cpu/logs/%J.candidate_build.out
#BSUB -e /work/apac2602/qwen38-cpu/logs/%J.candidate_build.err
set -euo pipefail
source /work/apac2602/qwen38-cpu/scripts/env.sh
ROOT=/work/apac2602/qwen38-cpu/optimization/20261018-v1
VARIANT=${EXPERIMENT_VARIANT:?set EXPERIMENT_VARIANT}
[[ "$VARIANT" =~ ^[a-z0-9-]+$ ]]
SRC="$ROOT/sources/$VARIANT"
BUILD="$SRC/build"
if [[ "$VARIANT" == mkl || "$VARIANT" == ipo ]]; then
    SRC="$ROOT/sources/native"
    BUILD="$ROOT/builds/$VARIANT"
    mkdir -p "$ROOT/variants/$VARIANT" "$ROOT/builds"
    [[ -L "$ROOT/variants/$VARIANT/build" ]] || ln -s "$BUILD" "$ROOT/variants/$VARIANT/build"
fi
OUT="$ROOT/logs/build_${VARIANT}_${LSB_JOBID}"
mkdir -p "$OUT"
trap 'echo BUILD_FAILED > "$OUT/status"' ERR
echo BUILDING > "$OUT/status"
flags='-fp-model precise -no-ftz -xCORE-AVX512 -qsimd-honor-fp-model -diag-disable=10441'
[[ "$VARIANT" != ipo ]] || flags="$flags -ipo"
if [[ "$VARIANT" == diagnostic ]]; then
    flags="$flags -DGGML_CPU_NODE_STATS -DGGML_CPU_SHAPE_STATS"
fi
omp=ON
[[ "$VARIANT" != native ]] || omp=OFF
blas=OFF
extra=()
if [[ "$VARIANT" == mkl ]]; then
    blas=ON
    export MKLROOT=/share/intel/oneapi-2023.1/mkl/2023.1.0
    extra=(-DGGML_BLAS_VENDOR=Intel10_64lp -DBLAS_INCLUDE_DIRS="$MKLROOT/include")
fi
{
    date -Is
    hostname
    lscpu
    module list
    icc --version
} > "$OUT/environment.txt" 2>&1
cmake -S "$SRC" -B "$BUILD" \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
    -DCMAKE_C_COMPILER=icc -DCMAKE_CXX_COMPILER=icpc \
    -DCMAKE_C_FLAGS="-gcc-name=/share/base/e5/gcc/11.2.0/bin/gcc $flags" \
    -DCMAKE_CXX_FLAGS="-gxx-name=/share/base/e5/gcc/11.2.0/bin/g++ $flags" \
    -DCMAKE_EXE_LINKER_FLAGS='-Wl,--no-as-needed,/lib64/libm.so.6,--as-needed' \
    -DCMAKE_SHARED_LINKER_FLAGS='-Wl,--no-as-needed,/lib64/libm.so.6,--as-needed' \
    -DGGML_NATIVE=ON -DGGML_OPENMP="$omp" -DGGML_OPENMP_FETCH=OFF \
    -DGGML_BLAS="$blas" "${extra[@]}" -DGGML_CUDA=OFF -DGGML_HIP=OFF -DGGML_VULKAN=OFF \
    -DGGML_SYCL=OFF -DGGML_OPENCL=OFF -DGGML_RPC=OFF -DGGML_METAL=OFF -DGGML_MUSA=OFF \
    -DLLAMA_BUILD_TESTS=ON -DLLAMA_BUILD_EXAMPLES=ON -DLLAMA_BUILD_TOOLS=ON \
    -DLLAMA_BUILD_SERVER=ON -DLLAMA_BUILD_APP=OFF -DLLAMA_BUILD_UI=OFF \
    -DLLAMA_USE_PREBUILT_UI=OFF -DLLAMA_OPENSSL=OFF -DFETCHCONTENT_FULLY_DISCONNECTED=ON \
    > "$OUT/configure.log" 2>&1
cmake --build "$BUILD" --target llama-cli llama-server llama-bench llama-perplexity test-quantize-fns -j 40 > "$OUT/build.log" 2>&1
"$BUILD/bin/test-quantize-fns" > "$OUT/quantize-tests.log" 2>&1
for name in llama-cli llama-server llama-bench llama-perplexity; do
    test -x "$BUILD/bin/$name"
    ldd "$BUILD/bin/$name" >> "$OUT/ldd.txt"
done
! grep -q 'not found' "$OUT/ldd.txt"
sha256sum "$BUILD/bin/llama-bench" "$BUILD/bin/llama-perplexity" "$BUILD/bin/libggml-cpu.so" > "$OUT/sha256.txt"
cp "$BUILD/CMakeCache.txt" "$OUT/CMakeCache.txt"
echo BUILD_READY > "$OUT/status"
printf '%s\n' "$OUT" > "$ROOT/results/${VARIANT}.build"
