#!/bin/bash
#BSUB -J qwen38_load_mode_confirm
#BSUB -q ssc-cpu
#BSUB -m hg_6148
#BSUB -n 40
#BSUB -R "span[ptile=40]"
#BSUB -W 03:00
#BSUB -o /work/apac2602/qwen38-cpu/logs/%J.load-mode.out
#BSUB -e /work/apac2602/qwen38-cpu/logs/%J.load-mode.err
set -euo pipefail
ROOT=/work/apac2602/qwen38-cpu/optimization/20261018-v1
cd "$ROOT"
OUT="$ROOT/results/confirmation_${LSB_JOBID}"
mkdir -p "$OUT"
trap 'echo FAILED > "$OUT/status"' ERR
{ date -Is; hostname; lscpu; free -h; } > "$OUT/environment.txt"
for name in copy-interleave baseline; do
    echo "RUNNING $name" > "$OUT/status"
    export EXPERIMENT_POLICY=$name
    [[ "$name" != baseline ]] || export EXPERIMENT_POLICY=reference
    export EXPERIMENT_OUTPUT_DIR="$ROOT/results/confirm-${name}_${LSB_JOBID}"
    bash "$ROOT/scripts/benchmark_load_mode.lsf" > "$OUT/$name.out" 2> "$OUT/$name.err"
done
echo READY > "$OUT/status"
date -Is > "$OUT/completed.txt"
