#!/bin/bash
#BSUB -J qwen38_concat_parallel
#BSUB -q ssc-cpu
#BSUB -m hg_6148
#BSUB -n 40
#BSUB -R "span[ptile=40]"
#BSUB -W 00:15
#BSUB -o /work/apac2602/qwen38-cpu/logs/%J.concat_test.out
#BSUB -e /work/apac2602/qwen38-cpu/logs/%J.concat_test.err
set -euo pipefail
source /work/apac2602/qwen38-cpu/scripts/env.sh
ROOT=/work/apac2602/qwen38-cpu/optimization/20261018-v1
OUT="$ROOT/results/concat_parallel_${LSB_JOBID}"
mkdir -p "$OUT"
trap 'echo FAILED > "$OUT/status"' ERR
echo RUNNING > "$OUT/status"
BASE=/work/apac2602/qwen38-cpu/llama.cpp
icpc -gxx-name=/share/base/e5/gcc/11.2.0/bin/g++ -std=c++17 -O2 -qopenmp -fp-model precise -no-ftz -xCORE-AVX512 -diag-disable=10441 \
    -I"$BASE/ggml/include" -I"$BASE/ggml/src" -I"$BASE/ggml/src/ggml-cpu" \
    "$ROOT/scripts/concat-parallel.cpp" -L"$BASE/build/bin" -lggml-cpu -lggml-base -ldl \
    -Wl,-rpath,"$BASE/build/bin" -Wl,--no-as-needed,/lib64/libm.so.6,--as-needed \
    -o "$OUT/concat-diff" > "$OUT/build.log" 2>&1
"$OUT/concat-diff" "$BASE/build/bin/libggml-cpu.so" "$ROOT/sources/concat/build/bin/libggml-cpu.so" > "$OUT/test.log" 2>&1
echo READY > "$OUT/status"
