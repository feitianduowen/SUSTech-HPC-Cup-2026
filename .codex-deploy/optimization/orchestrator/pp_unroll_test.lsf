#!/bin/bash
#BSUB -J qwen38_pp_unroll_test
#BSUB -q ssc-cpu
#BSUB -m hg_6148
#BSUB -n 40
#BSUB -R "span[ptile=40]"
#BSUB -W 00:30
#BSUB -o /work/apac2602/qwen38-cpu/logs/%J.pp_unroll.out
#BSUB -e /work/apac2602/qwen38-cpu/logs/%J.pp_unroll.err
set -euo pipefail
source /work/apac2602/qwen38-cpu/scripts/env.sh
ROOT=/work/apac2602/qwen38-cpu/optimization/20261018-v1
OUT="$ROOT/results/pp_unroll_${LSB_JOBID}"
mkdir -p "$OUT"
trap 'echo FAILED > "$OUT/status"' ERR
echo RUNNING > "$OUT/status"
export PP_KERNEL_TIMING=1
python3 "$ROOT/scripts/build_pp_diff.py" "$OUT" "$ROOT/scripts/sgemm-unroll.cpp" > "$OUT/build-test.log" 2>&1
python3 "$ROOT/scripts/compare_pp_assembly.py" "$OUT" > "$OUT/assembly.log"
echo READY > "$OUT/status"
