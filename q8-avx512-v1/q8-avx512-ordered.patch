+        __m512i qy = _mm512_castsi256_si512(_mm256_loadu_si256((const __m256i *) y[ib].qs));
+        qx = _mm512_inserti64x4(qx, _mm256_loadu_si256((const __m256i *) x[ib + 1].qs), 1);
